# ── PDFs (large binaries — keep out of repo) ──────────────────────────
*.pdf

# ── Python cache ─────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── PlatformIO build output ──────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/

# ── ESP-IDF generated files ──────────────────────────────────────────
build/
sdkconfig
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock
*.elf
*.map
*.bin

# ── IDE & editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Test build artifacts ───────────────────────────────────────────
*.exe
/test_physics
/test_pid

# ── Internal docs (not for sync) ─────────────────────────────────────
/standards/
/legacy/
/docs-main/

# ── Temporary analysis & working files ──────────────────────────────────
/tem/

# ── PDF extraction tool artifacts ────────────────────────────────────
/extract_pdfs.py

# ── Generated CMakeLists (PlatformIO manages its own) ────────────────
CMakeLists.txt

# ── Coverage & profiling ─────────────────────────────────────────────
*.gcda
*.gcno
*.gcov
coverage/

# ── Build artifacts ──────────────────────────────────────────────────
*.o
*.out
*.old
*.bak

# ── Claude Code ──────────────────────────────────────────────────────
.claude/

# ── LaTeX build artifacts ────────────────────────────────────────────
*.aux
*.log
*.toc
