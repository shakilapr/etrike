# ── PDFs (large binaries — keep out of repo) ──────────────────────────
*.pdf

# ── Python cache ─────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── PlatformIO build output ──────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/

# ── ESP-IDF generated files ──────────────────────────────────────────
build/
sdkconfig
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock
*.elf
*.map
*.bin

# ── IDE & editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Test build artifacts (leaked to root during host testing) ─────────
/esp_log.h
/esp_timer.h
/esp_system.h
/stubs.h
/stubs.cpp
/test_physics.cpp
/test_pid.cpp
/driver/
/freertos/
/test_physics
/test_pid

# ── Internal docs (not for sync) ─────────────────────────────────────
/docs/
/notes/

# ── PDF extraction tool artifacts ────────────────────────────────────
/extract_pdfs.py

# ── Generated CMakeLists (PlatformIO manages its own) ────────────────
CMakeLists.txt

# ── Coverage & profiling ─────────────────────────────────────────────
*.gcda
*.gcno
*.gcov
coverage/
