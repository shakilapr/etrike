BA_ "GenMsgCycleTime" BO_ 0x203 1000;
BA_ "GenMsgCycleTime" BO_ 0x6FA 10;
BA_ "GenMsgCycleTime" BO_ 0x7B9 20;
BA_ "GenMsgCycleTime" BO_ 0x721 10;
