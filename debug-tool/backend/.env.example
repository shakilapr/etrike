# Debug Tool Backend — Environment Variables
# Copy this file to .env and adjust for your setup.

# Transport: "serial" (USB ESP32-S3 bridge) or "canalystii" (CANalyst-II)
CAN_TRANSPORT=serial

# Serial port (Windows default: COM3, Linux: /dev/ttyUSB0, macOS: /dev/cu.usbserial-*)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# CANalyst-II settings (only used when CAN_TRANSPORT=canalystii)
CANALYST_BITRATE=500000
CANALYST_POLL_MS=10
CANALYST_DEVICE_INDEX=0
CANALYST_CH0_BUS=low
CANALYST_CH1_BUS=high

# Server
PORT=3000
HOST=127.0.0.1

# UI serving (set to "true" to serve the built UI from ../ui/dist)
SERVE_UI=false

# SQLite database file (relative to backend/ or absolute)
DB_PATH=./debug-tool.db

# Logging
# LOG_LEVEL=debug
