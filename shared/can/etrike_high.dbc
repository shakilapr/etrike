CM_ BO_ 1  "DLC=0  the frame ID itself is the ESTOP signal. Any node can send (RT is nominal). Bridged bidirectionally. Highest priority CAN frame.";
CM_ BO_ 17  "Forwarded lowhigh by RT. Same payload on both buses. DLC=3 adds light state (v0.0.5).";
CM_ BO_ 288  "Current vehicle speed from MTR STM32. Forwarded lowhigh by RT. SYS_ prefix is historical.";
CM_ BO_ 518  "Motor feedback from STM32. Forwarded lowhigh by RT per gateway rules.";
CM_ BO_ 528  "RT state report to Host. High bus only.";
CM_ BO_ 544  "RESERVED, inactive. PID telemetry for Host debugging.";
CM_ BO_ 768  "Host (Jetson Orin) Autoware.Auto drive command -> RT. High bus only.";
CM_ BO_ 769  "On demand. RT arbitrates: max(RT_computed, HOST_request) -> 0x205.";
CM_ BO_ 770  "Forwarded transparently highlow by RT.";
CM_ BO_ 784  "Steering telemetry to Host. v0.0.4  previously missing from DBC.";
CM_ BO_ 785  "Brake telemetry to Host. v0.0.4  previously missing from DBC.";
CM_ BO_ 1024  "Host sends min obstacle distance (from LiDAR/camera perception) to RT at 10 Hz. High bus only.";
CM_ BO_ 1536  "SYS diagnostics report. Forwarded lowhigh by RT.";
CM_ BO_ 2044  "Not bridged, high bus only. Loss triggers controlled stop, not ESTOP.";
CM_ BO_ 2045  "RT sends independently on both buses (per-bus, NOT bridged). Separate counters. This is the high-bus instance.";

CM_ SG_ 17 SYS_HeartbeatOk "0=RT alive counter frozen >1000ms, 1=incrementing";
CM_ SG_ 17 SYS_LightState "bit0=left_turn_active, bit1=right_turn_active, bit2=brake_light_active, bit3=headlight_active";
CM_ SG_ 518 MTR_FaultFlags "bit0=ESTOP, bit1=CMD timeout, bit2=ADC fault, bit3=gear conflict";
CM_ SG_ 768 HOST_DriveSpeed "ROS 2: linear.x * 1000";
CM_ SG_ 768 HOST_YawRate "ROS 2: angular.z * 1000. i24 big-endian at bytes 4-6.";
CM_ SG_ 784 SteerDiag_Angle0_1deg "Actual steering angle. physical_deg = raw * 0.1 - 3000. Raw 30000 -> 0deg.";
CM_ SG_ 784 SteerDiag_Fault "0=OK, 1=EPS-C fault";
CM_ SG_ 784 SteerDiag_MotorCurrent "EPS-C motor current, 0.01A/bit";
CM_ SG_ 784 SteerDiag_ECUTemp "EPS-C ECU temperature, 0.1degC/bit";
CM_ SG_ 785 BrakeDiag_PressureRaw "SEB pressure raw, 0.05 MPa/bit";
CM_ SG_ 785 BrakeDiag_Fault "0=OK, 1=SEB fault";
CM_ SG_ 785 BrakeDiag_MotorCurrent "SEB motor current, 0.01A/bit";
CM_ SG_ 785 BrakeDiag_ECUTemp "SEB ECU temperature, 0.1degC/bit";
CM_ SG_ 1024 HOST_ObstacleDistance "UINT32_MAX = no reading / timeout";
CM_ SG_ 2044 Host_AliveCtr "Timeout 1500ms -> controlled stop. Host is QM, not safety-critical.";
CM_ SG_ 2045 RT_AliveCtr "High bus timeout 1500ms->Host stops /cmd_vel";

CM_ BU_ Host "Orin NX, Linux + ROS 2, perception/planning";
CM_ BU_ RT "ESP32-S3, FreeRTOS, realtime kinematics + CAN gateway";
CM_ BU_ SYS "ESP32-S3, FreeRTOS, safety + motor + body control";
CM_ BU_ MTR "STM32, bare metal, motor DAC + gear relays (EGAS L1)";
CM_ BU_ Any "Wildcard  any node may send (e.g., ESTOP frames)";

