CM_ BO_ 361  "steer-by-wire unit command. 50 Hz continuous. Byte 5 overlap: Speed[15:8] shares with security nibble per CSV.";
CM_ BO_ 513  "steer-by-wire unit status feedback. 100 Hz. Byte 5 overlap: StrAngleSpd[15:8] / Torq share byte 5 per CSV.";
CM_ BO_ 514  "steer-by-wire unit detailed fault flags. 8 L3 faults (redundant sensor loss) -> RT must escalate to ESTOP.";
CM_ BO_ 515  "steer-by-wire unit firmware version. Log on boot for compatibility check.";
CM_ BO_ 1786  "steer-by-wire unit telemetry. 100 Hz. Bytes 0,7 reserved. Narrower ranges than brake SEB_Test.";

CM_ SG_ 361 SES_AlignEnable "Angle Initial Alignment Enable. 0=disabled, 1=centering.";
CM_ SG_ 361 SES_CtrlEnable "Direction Control Enable. 0=Disabled, 1=Enable (Angle Control).";
CM_ SG_ 361 SES_TgtStrAngle "Target Steering Angle. Negative=left. Offset=-3000 per mfr CSV.";
CM_ SG_ 361 SES_TgtStrAngleSpd "Target Angle Speed. Overlaps security signals at byte 5 per CSV. Effective 10-bit: bits 0-7 in byte 4, bits 8-9 in byte 5 bits 2-3. Bits 10-15 overlaid.";
CM_ SG_ 361 SES_RollCntEnable "Life Signal Enable  MUST be 1. Overlaps Speed[15:8].";
CM_ SG_ 361 SES_ChecksumEnable "Checksum Enable  MUST be 1.";
CM_ SG_ 361 SES_RollCnt "Life Signal rolling counter. Increment every frame.";
CM_ SG_ 361 SES_VehSpd "Vehicle speed populated by RT.";
CM_ SG_ 361 SES_Checksum "Checksum = XOR(bytes 0-6) ^ 0xFF.";
CM_ SG_ 513 SES_AngleStatus "Center Finding Status. 0=Finding, 1=Found.";
CM_ SG_ 513 SES_CtrlModeStatus "Control Mode Feedback. 0=Manual, 1=Automatic.";
CM_ SG_ 513 SES_ErrorStatus "Error Status.";
CM_ SG_ 513 SES_StrAngle "Steering Angle. Raw 30000->0deg, 23000->-700deg, 37000->700deg.";
CM_ SG_ 513 SES_TgtStrAngleSpd_FB "Angle Speed feedback. 16-bit signed. Overlaps Torq at byte 5.";
CM_ SG_ 513 SES_SteeringTorq "Steering Torque. Init 0x79 (121 raw = 0 Nm). Overlaps Speed[15:8].";
CM_ SG_ 513 SES_RollCntEnStatus "Life Signal Enable Feedback.";
CM_ SG_ 513 SES_ChecksumEnStatus "Checksum Enable Feedback.";
CM_ SG_ 513 SES_RollCntStatus "Life Signal Feedback  echoes rolling counter.";
CM_ SG_ 513 SES_ChecksumStatus "Checksum Feedback = XOR(bytes 0-6) ^ 0xFF.";
CM_ SG_ 514 SES_ECUUnderVolt "Controller Under Voltage [L2]";
CM_ SG_ 514 SES_ECUOverVolt "Controller Over Voltage [L2]";
CM_ SG_ 514 SES_CanComErr "CAN Communication Fault [L1]";
CM_ SG_ 514 SES_ECUTempErr "Controller Temp Fault [L1]";
CM_ SG_ 514 SES_DomainSC "Domain Drive Short Circuit [L2]";
CM_ SG_ 514 SES_DomainV "Domain Drive Voltage Fault [L2]";
CM_ SG_ 514 SES_DomainT "Domain Drive Temperature Fault [L2]";
CM_ SG_ 514 SES_TempSensor "Temperature Sensor Fault";
CM_ SG_ 514 SES_AngleP_OC "Angle Sensor Pri. Open Circuit [L3]";
CM_ SG_ 514 SES_AngleP_AF "Angle Sensor Pri. Out of Range [L3]";
CM_ SG_ 514 SES_AngleS_OC "Angle Sensor Sec. Open Circuit [L3]";
CM_ SG_ 514 SES_AngleS_AF "Angle Sensor Sec. Out of Range [L3]";
CM_ SG_ 514 SES_SensorPow "Sensor Power Fault [L2]";
CM_ SG_ 514 SES_Alignment "Centering Fault [L1]";
CM_ SG_ 514 SES_OverAngle "Over Angle Fault [L2]";
CM_ SG_ 514 SES_StrMtrStall "Motor Stall Fault [L1]";
CM_ SG_ 514 SES_MtrCurtFault "Motor Current Fault [L2]";
CM_ SG_ 514 SES_SensorCL "Sensor 5V Power Fault [L2]";
CM_ SG_ 514 SES_TorqT1_OC "Torque Sensor T1 Open Circuit [L3]";
CM_ SG_ 514 SES_TorqT1_AF "Torque Sensor T1 Out of Range [L3]";
CM_ SG_ 514 SES_TorqT2_OC "Torque Sensor T2 Open Circuit [L3]";
CM_ SG_ 514 SES_TorqT2_AF "Torque Sensor T2 Out of Range [L3]";
CM_ SG_ 514 SES_SentAngle "Angle Error [L1]";
CM_ SG_ 514 SES_StrMtrIdling "Motor Idling Fault [L2]";
CM_ SG_ 514 SES_EPROM "EEPROM Fault [L2]";
CM_ SG_ 514 SES_VehSpdSnapshot "Vehicle speed at fault snapshot.";
CM_ SG_ 515 SES_SW_Version "Software version (e.g. 0x64 = 1.00)";
CM_ SG_ 515 SES_HW_Version "Hardware version (e.g. 0x0D = 1.3)";
CM_ SG_ 1786 SES_MtrCurt "Motor current. Monitor for mechanical binding / rack damage.";
CM_ SG_ 1786 SES_ECUTemp "ECU temperature. For thermal throttling.";
CM_ SG_ 1786 SES_PowVolt "Supply voltage. 0-18V range.";

CM_ BU_ RT "ESP32-S3, FreeRTOS, realtime kinematics + CAN gateway";
CM_ BU_ EPS_C "steer-by-wire unit, steer-by-wire module, preprogrammed CAN IDs";

