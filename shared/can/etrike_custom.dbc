CM_ BO_ 1  "DLC=0  the frame ID itself is the ESTOP signal. Bridged bidirectionally by RT. Highest priority CAN frame.";
CM_ BO_ 17  "Forwarded low->high by RT. Same payload on both buses.";
CM_ BO_ 18  "DC-DC converter control. Low bus only.";
CM_ BO_ 272  "0=Manual, 1=Auto, 2=ESTOP. Low bus only.";
CM_ BO_ 288  "Current vehicle speed from MTR STM32. Forwarded low->high by RT.";
CM_ BO_ 516  "MTR receives for motor actuation. SYS receives for EGAS L2 monitoring. ID 0x204 avoids collision with EPS-C 0x202.";
CM_ BO_ 517  "RT max-select: max(rt_obstacle, jetson_0x301) -> SYS SEB cmd.";
CM_ BO_ 518  "Motor feedback from STM32. Low bus only.";
CM_ BO_ 528  "RT state report to Jetson. High bus only.";
CM_ BO_ 544  "RESERVED, inactive. PID telemetry for Jetson debugging.";
CM_ BO_ 768  "Jetson Autoware.Auto drive command -> RT. High bus only.";
CM_ BO_ 769  "On demand. RT arbitrates: max(RT_computed, HOST_request) -> 0x205.";
CM_ BO_ 770  "Forwarded transparently high->low by RT.";
CM_ BO_ 1024  "RT reports min obstacle distance to Jetson at 10 Hz. High bus only.";
CM_ BO_ 1536  "SYS diagnostics report. Forwarded low->high by RT.";
CM_ BO_ 2044  "Not bridged, high bus only. Loss triggers controlled stop, not ESTOP.";
CM_ BO_ 2045  "RT sends independently on both buses (per-bus, NOT bridged). Separate counters.";
CM_ BO_ 2046  "Low bus only, never leaves low bus.";

CM_ SG_ 17 SYS_HeartbeatOk "0=RT alive counter frozen >1000ms, 1=incrementing";
CM_ SG_ 18 SYS_DcdcEnable "ESTOP->1(on); maintains 12V for MCUs, CAN transceivers, brake light";
CM_ SG_ 518 MTR_FaultFlags "bit0=ESTOP, bit1=CMD timeout, bit2=ADC fault, bit3=gear conflict";
CM_ SG_ 768 HOST_DriveSpeed "ROS 2: linear.x * 1000";
CM_ SG_ 768 HOST_YawRate "ROS 2: angular.z * 1000";
CM_ SG_ 1024 RT_ObstacleDistance "UINT32_MAX = no reading / timeout";
CM_ SG_ 2044 Jetson_AliveCtr "Timeout 1500ms -> controlled stop. Jetson is QM, not safety-critical.";
CM_ SG_ 2045 RT_AliveCtr "Low bus timeout 1000ms->SYS ESTOP; High bus 1500ms->Jetson stops /cmd_vel";
CM_ SG_ 2046 SYS_AliveCtr "10 Hz / 200ms timeout -> RT brake takeover + ESTOP";

CM_ BU_ Jetson "Orin NX, Linux + ROS 2, perception/planning";
CM_ BU_ RT "ESP32-S3, FreeRTOS, realtime kinematics + CAN gateway";
CM_ BU_ SYS "ESP32-S3, FreeRTOS, safety + motor + body control";
CM_ BU_ MTR "STM32, bare metal, motor DAC + gear relays (EGAS L1)";
CM_ BU_ DCDC "DC-DC converter (72V->12V), CAN 0x012 control";

