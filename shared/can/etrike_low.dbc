CM_ BO_ 1  "DLC=0  the frame ID itself is the ESTOP signal. Any node can send (RT is nominal). Bridged bidirectionally. Highest priority CAN frame.";
CM_ BO_ 17  "Forwarded lowhigh by RT. Same payload on both buses. DLC=3 adds light state (v0.0.5).";
CM_ BO_ 18  "DC-DC converter control. Low bus only.";
CM_ BO_ 272  "0=Manual, 1=Auto, 2=ESTOP. Low bus only. MTR needs mode for pass-through vs CAN control.";
CM_ BO_ 288  "Current vehicle speed from MTR STM32. Forwarded lowhigh by RT. SYS_ prefix is historical.";
CM_ BO_ 516  "MTR receives for motor actuation. SYS receives for EGAS L2 monitoring. ID 0x204 avoids collision with EPS-C 0x202.";
CM_ BO_ 517  "RT max-select: max(rt_obstacle, host_0x301) -> SYS SEB cmd.";
CM_ BO_ 518  "Motor feedback from STM32. Forwarded lowhigh by RT per gateway rules.";
CM_ BO_ 770  "Forwarded transparently highlow by RT.";
CM_ BO_ 1536  "SYS diagnostics report. Forwarded lowhigh by RT.";
CM_ BO_ 2045  "RT sends independently on both buses (per-bus, NOT bridged). Separate counters. This is the low-bus instance.";
CM_ BO_ 2046  "Low bus only, never leaves low bus.";

CM_ SG_ 17 SYS_HeartbeatOk "0=RT alive counter frozen >1000ms, 1=incrementing";
CM_ SG_ 17 SYS_LightState "bit0=left_turn_active, bit1=right_turn_active, bit2=brake_light_active, bit3=headlight_active";
CM_ SG_ 18 SYS_DcdcEnable "ESTOP->1(on); maintains 12V for MCUs, CAN transceivers, brake light";
CM_ SG_ 518 MTR_FaultFlags "bit0=ESTOP, bit1=CMD timeout, bit2=ADC fault, bit3=gear conflict";
CM_ SG_ 2045 RT_AliveCtr "Low bus timeout 1000ms->SYS ESTOP";
CM_ SG_ 2046 SYS_AliveCtr "10 Hz / 200ms timeout -> RT brake takeover + ESTOP";

CM_ BU_ Host "Orin NX, Linux + ROS 2, perception/planning";
CM_ BU_ RT "ESP32-S3, FreeRTOS, realtime kinematics + CAN gateway";
CM_ BU_ SYS "ESP32-S3, FreeRTOS, safety + motor + body control";
CM_ BU_ MTR "STM32, bare metal, motor DAC + gear relays (EGAS L1)";
CM_ BU_ Any "Wildcard  any node may send (e.g., ESTOP frames)";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;


