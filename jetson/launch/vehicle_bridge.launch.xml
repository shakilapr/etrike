<?xml version="1.0"?>
<launch>
  <!--
    E-Trike Autoware Vehicle Bridge — launch configuration.

    Bridge uses standard Autoware.Auto global topics directly:
      Subscriptions: /control/command/control_cmd, /control/command/gear_cmd,
                     /control/command/turn_indicators_cmd, /control/command/hazard_lights_cmd,
                     /control/control_mode_request, /control/command/emergency_cmd
      Publications:  /vehicle/status/velocity_status, /vehicle/status/steering_status,
                     /vehicle/status/gear_status, /vehicle/status/control_mode,
                     /vehicle/status/turn_indicators_status, /vehicle/status/hazard_lights_status,
                     /vehicle/status/kinematic_state

    The only remapped topic is Engage — bridge uses local namespace, Autoware publishes globally.
  -->
  <node name="vehicle_bridge" pkg="autoware_vehicle_bridge" exec="vehicle_bridge_node">
    <remap from="~/input/engage" to="/control/command/engage"/>
  </node>
</launch>
